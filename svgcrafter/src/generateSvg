// generateSvg.js
// ---------------------------------------------------------------------------
// Pure function: takes a config object, returns a self-contained SVG string.
//
// Two deliberate design rules (these are what make the project easy to grow):
//   1. NO DOM access in here. Everything it needs is passed in via `config`.
//      That keeps it trivial to unit-test (config in -> string out).
//   2. The output animates with CSS + SMIL ONLY. No <script>. This is the
//      one hard requirement for SVGs that animate on a GitHub README, because
//      GitHub renders them as images (JS inside is never executed).
//
// Text width can't be known without measuring the rendered font, so the caller
// (App.jsx) measures it with a canvas and passes `textWidth` in.
// ---------------------------------------------------------------------------

const FONT_STACK = "'Segoe UI', system-ui, -apple-system, Arial, sans-serif";

export function generateSvg(config) {
  const {
    text = "Your Name",
    textColor = "#bef264",
    bgColor = "#0a0a0a",
    fontSize = 40,
    fontWeight = 700,
    animate = true,
    borderRadius = 14,
    duration = 2,
    textWidth = 220, // measured by the caller; fallback keeps this usable alone
  } = config;

  const padding = 28;
  const height = Math.round(fontSize * 2.2);
  const width = Math.round(textWidth + padding * 2);
  const baseline = Math.round(height / 2 + fontSize * 0.35);
  const cursorY = Math.round((height - fontSize) / 2);
  const safeText = escapeXml(text);

  const background = `<rect width="100%" height="100%" fill="${bgColor}" rx="${borderRadius}"/>`;

  const staticText =
    `<text x="${padding}" y="${baseline}" fill="${textColor}" ` +
    `font-family="${FONT_STACK}" font-size="${fontSize}" font-weight="${fontWeight}">` +
    `${safeText}</text>`;

  if (!animate) {
    return wrap(width, height, safeText, `${background}\n  ${staticText}`);
  }

  const body = `
  <style>
    .cursor { animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
  </style>
  ${background}
  <defs>
    <clipPath id="reveal">
      <rect x="${padding}" y="0" width="0" height="${height}">
        <animate attributeName="width" from="0" to="${textWidth}"
                 dur="${duration}s" fill="freeze" calcMode="linear"/>
      </rect>
    </clipPath>
  </defs>
  <text x="${padding}" y="${baseline}" fill="${textColor}"
        font-family="${FONT_STACK}" font-size="${fontSize}" font-weight="${fontWeight}"
        clip-path="url(#reveal)">${safeText}</text>
  <rect class="cursor" x="${padding}" y="${cursorY}" width="3" height="${fontSize}" fill="${textColor}">
    <animate attributeName="x" from="${padding}" to="${padding + textWidth}"
             dur="${duration}s" fill="freeze" calcMode="linear"/>
  </rect>`;

  return wrap(width, height, safeText, body);
}

function wrap(width, height, label, inner) {
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" role="img" aria-label="${label}">
  ${inner}
</svg>`;
}

function escapeXml(s) {
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}